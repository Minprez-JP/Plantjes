{
  "name": "plantjes",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:security": "eslint src --max-warnings=0",
    "security:reports": "node scripts/security-reports.mjs",
    "sbom:generate": "node scripts/security/generate-sbom.mjs",
    "licences:generate": "node scripts/security/generate-licences.mjs",
    "verify:install": "node scripts/security/verify-install.mjs",
    "verify:ci-gates": "node scripts/security/verify-ci-gates.mjs",
    "verify:audit": "node scripts/security/verify-audit-policy.mjs",
    "verify:no-egress": "node scripts/security/verify-no-egress.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "security:check": "npm audit --audit-level=high --omit=dev && npm run security:reports && npm test && npm run build && npm run verify:no-egress"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "dexie": "^4.4.7",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@babel/eslint-parser": "8.1.2",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@cyclonedx/cyclonedx-npm": "7.0.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "jsdom": "^31.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
